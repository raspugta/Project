# Copy to .env and `set -a; . ./.env; set +a` before starting, or export these yourself.

# Server
BAYMAX_HOST=127.0.0.1          # keep local; do not expose to a network without adding authentication
BAYMAX_PORT=8765
BAYMAX_DATA=./data             # SQLite database directory

# Local speech recognition (pip install faster-whisper)
BAYMAX_STT=local               # local | off
BAYMAX_WHISPER_MODEL=small     # tiny | base | small | medium | large-v3
BAYMAX_WHISPER_DEVICE=auto     # auto | cpu | cuda
BAYMAX_WHISPER_COMPUTE=int8

# Optional conversational LLM (never controls safety; output is guarded)
BAYMAX_LLM=none                # none | ollama | anthropic
BAYMAX_OLLAMA_URL=http://127.0.0.1:11434
BAYMAX_OLLAMA_MODEL=llama3.1:8b
# ANTHROPIC_API_KEY=...        # cloud use additionally requires the `cloud_llm` consent in the UI
BAYMAX_ANTHROPIC_MODEL=claude-sonnet-5

# E-mail alerts (webhook contacts need no configuration)
# BAYMAX_SMTP_HOST=smtp.example.com
# BAYMAX_SMTP_PORT=587
# BAYMAX_SMTP_USER=...
# BAYMAX_SMTP_PASSWORD=...
# BAYMAX_SMTP_FROM=baymax@example.com
# BAYMAX_SMTP_STARTTLS=1
